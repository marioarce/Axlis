<?xml version="1.0" encoding="utf-8"?>
<!--
  Template publish profile for Visual Studio's Build > Publish > "Folder" workflow.

  This lets you publish this project straight into a real Sitecore 10.2.x site's webroot (or an
  intermediate staging folder you then deploy to IIS by your own process) without hand-copying
  files as described in README.md's "Deploying this sample" section.

  Usage: copy this file (e.g. to "MySite.pubxml"), open it in Visual Studio via
  Build > Publish > New Profile > Import Profile, then replace the <publishUrl> placeholder below
  with the real destination path before publishing. The placeholder path is deliberately not a
  real path — publishing with it unedited will simply create a "CHANGE-ME" folder locally.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <publishUrl>C:\CHANGE-ME\path\to\your\sitecore\site\wwwroot</publishUrl>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
