<?xml version="1.0" encoding="utf-8"?>
<!--
  This is a MINIMAL, illustrative Web.config — not a real Sitecore site's Web.config. A real
  Sitecore 10.2.x installation's Web.config (normally produced by Sitecore's own installer/SIF)
  has many more required sections (Sitecore's own httpModules/handlers, session-state provider,
  custom errors, etc.) that are deliberately NOT reproduced here, since this repo has no Sitecore
  sandbox to generate or verify one against (see the package README's "Testing" section for why).

  To actually run this sample against a real Sitecore 10.2.x site: merge the <system.webServer>
  <modules> entry below into that site's real Web.config (after Sitecore's own module entries —
  see Axlis.Sitecore.Context.Sitecore102's README), and copy Pages/AxlisSitecoreContextDemo.aspx(.cs)
  into that site alongside it.
-->
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <modules>
      <!-- Must run after Sitecore's own request-initialization modules in a real site — see
           Axlis.Sitecore.Context.Sitecore102's README, "Confirm module ordering". -->
      <add name="AxlisSitecoreContextHttpModule" type="Axlis.Sitecore.Hosting.SitecoreContextHttpModule, Axlis.Sitecore.Context.Sitecore102" />
    </modules>
  </system.webServer>
</configuration>
