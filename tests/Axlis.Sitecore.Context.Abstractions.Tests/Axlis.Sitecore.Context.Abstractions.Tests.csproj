<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48, matching Axlis.Sitecore.Context.Abstractions itself (CallContext/ILogicalThreadAffinative
         are Framework-only, so the test project must target the same framework as the code under test). -->
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Axlis.Sitecore.Context\Axlis.Sitecore.Context.Abstractions\Axlis.Sitecore.Context.Abstractions.csproj" />
  </ItemGroup>

</Project>
